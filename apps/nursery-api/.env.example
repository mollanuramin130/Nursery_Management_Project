# ---- Environment profiles ----
# Local: copy .env.example → .env
# Staging: copy .env.staging.example → .env on staging host (APP_ENV=staging, Razorpay TEST keys)
# Production: copy .env.production.example → .env on production host (APP_ENV=production, APP_DEBUG=false)
# Never commit filled .env files. Never point staging/dev at the production database.

APP_NAME="GreenLeaf Nursery API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://api.yourdomain.com
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database switch: local | staging | production via these vars only ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nursery_local
DB_USERNAME=root
DB_PASSWORD=

# Hostinger example:
# DB_HOST=localhost
# DB_DATABASE=u123_nursery_prod
# DB_USERNAME=u123_prod
# DB_PASSWORD=********

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
# ---- Cache (production: use redis for multi-node JWT blacklist + shared cache) ----
CACHE_STORE=file
# CACHE_STORE=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ---- JWT / Auth (persistent login) ----
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=129600
# 129600 minutes = 90 days

# ---- CORS (website + admin origins; never use * with credentials) ----
# Local/dev only:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Production (required): set ONLY your real HTTPS origins — remove localhost.
# CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com

# ---- Logging (production: LOG_LEVEL=warning or error) ----
API_REQUEST_LOG_ENABLED=false
API_REQUEST_LOG_SAMPLE_RATE=0.1
API_REQUEST_LOG_MAX_BODY_CHARS=20000
API_OUTBOUND_LOG_ENABLED=false

# ---- Mail ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Payments ----
PAYMENT_DRIVER=razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Never enable in production. Local/dev only when webhook secret is empty.
PAYMENT_ALLOW_UNSIGNED_WEBHOOKS=false
COD_ENABLED=true
# Leave Razorpay keys empty for local_stub (non-production only).
# Production refuses stub create/verify and unsigned webhooks.
# Admin refunds refuse live stub processing in production.

# ---- Push (optional early; required for mobile notifications) ----
FCM_SERVER_KEY=
FIREBASE_CREDENTIALS=

# ---- App force-update ----
APP_MIN_ANDROID_VERSION=1.0.0
APP_MIN_IOS_VERSION=1.0.0
APP_FORCE_UPDATE=false

# ---- Store ----
STORE_CURRENCY=INR
FREE_DELIVERY_THRESHOLD=999
STORE_SUPPORT_EMAIL=support@example.com
STORE_SUPPORT_PHONE=

VITE_APP_NAME="${APP_NAME}"
