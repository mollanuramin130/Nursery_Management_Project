# Copy to .env on production host. Never commit filled values.

APP_NAME="GreenLeaf Nursery API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=nursery_prod
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
QUEUE_CONNECTION=database
# Multi-node / multiple workers: use redis for cache + JWT blacklist
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=129600
JWT_BLACKLIST_ENABLED=true

# Production shop + admin only — never localhost, never *
CORS_ALLOWED_ORIGINS=https://www.example.com,https://example.com,https://admin.example.com

API_REQUEST_LOG_ENABLED=false
API_REQUEST_LOG_SAMPLE_RATE=0.01
API_OUTBOUND_LOG_ENABLED=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Razorpay LIVE keys — never commit
PAYMENT_DRIVER=razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_ALLOW_UNSIGNED_WEBHOOKS=false
COD_ENABLED=true

FCM_SERVER_KEY=
FIREBASE_CREDENTIALS=

FILESYSTEM_DISK=public
STORE_CURRENCY=INR
FREE_DELIVERY_THRESHOLD=999
STORE_SUPPORT_EMAIL=support@example.com
STORE_SUPPORT_PHONE=

APP_MIN_ANDROID_VERSION=1.0.0
APP_FORCE_UPDATE=false
