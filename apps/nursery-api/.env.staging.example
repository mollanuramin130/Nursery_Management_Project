# Copy to .env on staging host. Never commit filled values.
# Source: apps/nursery-api/.env.example + Phase 13 staging profile

APP_NAME="GreenLeaf Nursery API (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-staging.example.com
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=nursery_staging
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
QUEUE_CONNECTION=database
CACHE_STORE=file
# Prefer redis when multiple PHP workers share JWT blacklist:
# CACHE_STORE=redis

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=129600
JWT_BLACKLIST_ENABLED=true

# Staging website + admin HTTPS origins only (no production origins)
CORS_ALLOWED_ORIGINS=https://staging.example.com,https://admin-staging.example.com

API_REQUEST_LOG_ENABLED=false
API_REQUEST_LOG_SAMPLE_RATE=0.05

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply-staging@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Razorpay TEST keys only on staging
PAYMENT_DRIVER=razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_ALLOW_UNSIGNED_WEBHOOKS=false
COD_ENABLED=true

FCM_SERVER_KEY=
FIREBASE_CREDENTIALS=

FILESYSTEM_DISK=public
STORE_CURRENCY=INR
FREE_DELIVERY_THRESHOLD=999
STORE_SUPPORT_EMAIL=support-staging@example.com
STORE_SUPPORT_PHONE=
